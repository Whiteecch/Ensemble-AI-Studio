# 运行产物：每场戏的存储、转录与角色私有记忆都落在这里，不进仓库
app/runs/
runs/
*.runtime.json
*.sqlite

# 打包产物与中间物（PyInstaller / Inno Setup）：scratch，绝不入库。
# 特别注意 build/tmp-appdata —— 开发态自测会把 APPDATA 重定向到这里，里面可能是
# 真实用户数据的副本，一旦入库就是泄露。
build/
dist/
app/build/
app/dist/
dist-baseline/
*.spec.bak
packaging/work/
packaging/dist/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 本地密钥/配置（模型 key 绝不入库）
.env
.env.*
app/.env.deepseek

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
